{
  "name": "@gachi-gacha/frontend",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "dev:mock": "MOCK_API=true webpack serve --mode development",
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test --runInBand && pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@stomp/stompjs": "7.3.0",
    "posthog-js": "1.434.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.2.0",
    "@storybook/react-webpack5": "10.5.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-jest": "30.2.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "kakao.maps.d.ts": "0.1.40",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "storybook": "10.5.6",
    "ts-loader": "^9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "undici": "8.11.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

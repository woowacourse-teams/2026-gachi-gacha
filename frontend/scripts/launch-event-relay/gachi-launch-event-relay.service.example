# Install only after review; this file does not alter existing services.
# /opt/gachi-launch-event-relay/node: fixed, supported Node.js executable.
# Do not depend on an Actions runner cache that a later job can replace.
# server.mjs and node must be root-owned and not writable by this service.
[Unit]
Description=GachiGacha frontend event authentication relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/gachi-launch-event-relay
ExecStart=/opt/gachi-launch-event-relay/node /opt/gachi-launch-event-relay/server.mjs
EnvironmentFile=/etc/gachi-launch-event-relay.env
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target

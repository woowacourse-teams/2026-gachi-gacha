# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# https://developers.kakao.com/console/app
KAKAO_MAP_KEY=

# true면 개발 서버의 API 요청을 MSW가 가로챕니다.
MOCK_API=true

# 로컬에서 실제 백엔드 OAuth/API를 확인할 때 /api 요청을 전달할 주소입니다.
API_PROXY_TARGET=http://localhost:8080

# 로컬 개발 데이터가 실제 제품 지표에 섞이지 않도록 기본값은 false입니다.
POSTHOG_ENABLED=false

# PostHog 프로젝트 설정 > Project API key
POSTHOG_API_KEY=
POSTHOG_API_HOST=https://us.i.posthog.com

# Sentry는 오류·스택·릴리스만 수집합니다. Replay와 성능 수집은 사용하지 않습니다.
# 로컬 기본값은 false이며, 인증 토큰은 .env가 아닌 GitHub Secret에만 보관합니다.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# false로 설정하면 제휴 UI와 생성 카탈로그를 불러오지 않습니다.
AFFILIATE_CATALOG_ENABLED=true

# PostHog에서 배포 환경을 구분할 때 사용하는 값입니다.
APP_ENV=local

# 이벤트 응모 기간과 Google Apps Script 웹 앱의 공개 /exec 주소입니다.
# schemaVersion 4, authentication: client-reported 수신부를 사용합니다.
# 회원번호·글 ID는 브라우저 전달값이며 GAS에서 진위를 검증하지 않습니다.
# 액세스 토큰·쿠키·비밀키는 이 설정이나 Google 제출 본문에 넣지 않습니다.
# 시작·종료 시각은 타임존을 포함한 ISO 8601 형식으로 입력합니다.
EVENT_APPLICATION_ENABLED=false
EVENT_APPLICATION_CAMPAIGN_ID=app-launch-2026
# 종료는 배타적 경계: 11/27 전체 접수 = 11/28 00:00 KST
EVENT_APPLICATION_BANNER_START_AT=2026-11-10T00:00:00+09:00
EVENT_APPLICATION_START_AT=2026-11-10T00:00:00+09:00
EVENT_APPLICATION_END_AT=2026-11-28T00:00:00+09:00
EVENT_APPLICATION_ENDPOINT=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# 신고 전용 Google Apps Script Web App URL입니다.
# 이벤트 응모 시트와 분리된 신고 전용 시트의 배포 주소를 사용합니다.
MEMBER_REPORT_ENDPOINT=https://script.google.com/macros/s/AKfycbyiplz7W4iOTPQRZK2-paQ5GVhAhyBNYmFPKKdIRzoSaVygfTI59Z8PMo1GpzUII-Da/exec

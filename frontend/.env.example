# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# https://developers.kakao.com/console/app
KAKAO_MAP_KEY=

# true면 개발 서버의 API 요청을 MSW가 가로챕니다.
MOCK_API=true

# 로컬에서 실제 백엔드 OAuth/API를 확인할 때 /api 요청을 전달할 주소입니다.
API_PROXY_TARGET=http://localhost:8080

# 로컬 개발 데이터가 실제 제품 지표에 섞이지 않도록 기본값은 false입니다.
POSTHOG_ENABLED=false

# PostHog 프로젝트 설정 > Project API key
POSTHOG_API_KEY=
POSTHOG_API_HOST=https://us.i.posthog.com

# true면 브라우저 런타임 오류를 Sentry 프로젝트로 전송합니다.
SENTRY_ENABLED=false

# Sentry 프로젝트의 Client Key(DSN)입니다. 브라우저에 포함되는 공개 연결 정보이며
# source map 업로드 권한을 가진 SENTRY_AUTH_TOKEN과는 다릅니다.
SENTRY_DSN=

# 아래 값은 production 빌드에서 source map을 Sentry로 업로드할 때만 사용합니다.
# SENTRY_AUTH_TOKEN은 로컬 파일에 두지 않고 GitHub Environment secret으로 관리합니다.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=local

# PostHog에서 배포 환경을 구분할 때 사용하는 값입니다.
APP_ENV=local

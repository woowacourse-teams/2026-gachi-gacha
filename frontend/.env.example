# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# https://developers.kakao.com/console/app
KAKAO_MAP_KEY=

# true면 개발 서버의 API 요청을 MSW가 가로챕니다.
MOCK_API=true

# 로컬 개발 데이터가 실제 제품 지표에 섞이지 않도록 기본값은 false입니다.
POSTHOG_ENABLED=false

# PostHog 프로젝트 설정 > Project API key
POSTHOG_API_KEY=
POSTHOG_API_HOST=https://us.i.posthog.com

# PostHog에서 배포 환경을 구분할 때 사용하는 값입니다.
APP_ENV=local

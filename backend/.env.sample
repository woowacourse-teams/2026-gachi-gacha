# ===== AWS =====
AWS_REGION=aaa
AWS_S3_BUCKET=aaa
AWS_S3_FOLDER=aaa

# ===== Docker Compose (로컬 전용) =====
POSTGRES_DB=aaa
POSTGRES_USER=aaa
POSTGRES_PASSWORD=aaa
POSTGRES_PORT=1234
MONGODB_PORT=12345

# ===== Database =====
# DB_USERNAME, DB_PASSWORD 는 위 POSTGRES_USER, POSTGRES_PASSWORD 와 같은 값을 사용한다.
DB_URL=aaa
DB_USERNAME=aaa
DB_PASSWORD=aaa
JPA_DDL_AUTO=validate
MONGODB_URI=mongodb://localhost:27017/gachi_gacha

# 로컬 테스트 전용 DB (개발 DB와 데이터가 섞이지 않도록 분리)
# 최초 1회 생성이 필요하다:
#   docker exec -it gachi-gacha-postgres psql -U gacha -d gacha_db -c "CREATE DATABASE gacha_db_test;"
# MongoDB 테스트 DB(gachi_gacha_test)는 테스트 실행 시 자동 생성된다.
TEST_DB_URL=jdbc:postgresql://localhost:5432/gacha_db_test?sslmode=disable

# ===== OAuth =====
KAKAO_REDIRECT_URL=http://localhost:8080/api/v1/oauth/login/kakao
KAKAO_CLIENT_ID=1234
KAKAO_CLIENT_SECRET=1234

NAVER_REDIRECT_URL=http://localhost:8080/api/v1/oauth/login/naver
NAVER_CLIENT_ID=1234
NAVER_CLIENT_SECRET=1234

# ===== JWT =====
JWT_EXPIRATION_DAY=1234
JWT_SECRET_KEY=123

# ===== CORS =====
# MVC CORS 와 WebSocket 핸드셰이크가 함께 사용한다. 여러 개는 쉼표로 구분한다.
# dev/prod 서버에는 해당 환경의 프론트 도메인을 등록한다.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*
